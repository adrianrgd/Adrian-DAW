<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
    <xs:element name="tarjetas">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="tarjeta" maxOccurs="unbounded">
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="titulo" type="xs:string" />
                            <xs:element name="imagen" type="xs:string" />
                            <xs:element name="año" type="xs:string" />
                            <xs:element name="fabricante" type="xs:string" />
                            <xs:element name="composicion" type="xs:string" />
                            <xs:element name="texto" type="xs:string" />
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>
            </xs:sequence>
        </xs:complexType>
    </xs:element>
</xs:schema>